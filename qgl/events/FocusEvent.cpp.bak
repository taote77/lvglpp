#include "FocusEvent.h"
#include "../widgets/Widget.h"
#include <sstream>
#include <unordered_map>

namespace QGL {

// 焦点原因到字符串的映射
static const std::unordered_map<FocusReason, String> focusReasonToStringMap = {
    {FocusReason::Mouse, "Mouse"},
    {FocusReason::Tab, "Tab"},
    {FocusReason::Backtab, "Backtab"},
    {FocusReason::ActiveWindow, "ActiveWindow"},
    {FocusReason::Popup, "Popup"},
    {FocusReason::Shortcut, "Shortcut"},
    {FocusReason::MenuBar, "MenuBar"},
    {FocusReason::Other, "Other"},
    {FocusReason::NoFocusReason, "NoFocusReason"}
};

// 字符串到焦点原因的映射
static std::unordered_map<String, FocusReason> stringToFocusReasonMap;

// 初始化反向映射
static void initializeStringToFocusReasonMap() {
    if (stringToFocusReasonMap.empty()) {
        for (const auto& pair : focusReasonToStringMap) {
            stringToFocusReasonMap[pair.second] = pair.first;
        }
    }
}

FocusEvent::FocusEvent(EventType type, Widget* oldFocus, Widget* newFocus, FocusReason reason)
    : Event(type), m_oldFocusWidget(oldFocus), m_newFocusWidget(newFocus), m_reason(reason),
      m_isTemporary(false), m_focusPolicy(FocusPolicy::StrongFocus),
      m_nextInFocusChain(nullptr), m_previousInFocusChain(nullptr),
      m_focusOrder(0), m_hasPartialFocus(false), m_showFocusIndicator(true) {
    setTimestamp(getCurrentTimestamp());
}

FocusEvent::FocusEvent(Widget* newFocus, FocusReason reason)
    : Event(EventType::Focus), m_oldFocusWidget(nullptr), m_newFocusWidget(newFocus), m_reason(reason),
      m_isTemporary(false), m_focusPolicy(FocusPolicy::StrongFocus),
      m_nextInFocusChain(nullptr), m_previousInFocusChain(nullptr),
      m_focusOrder(0), m_hasPartialFocus(false), m_showFocusIndicator(true) {
    setTimestamp(getCurrentTimestamp());
}

std::unique_ptr<FocusEvent> FocusEvent::createFocusInEvent(Widget* widget, FocusReason reason) {
    return std::make_unique<FocusInEvent>(widget, reason);
}

std::unique_ptr<FocusEvent> FocusEvent::createFocusOutEvent(Widget* widget, FocusReason reason) {
    return std::make_unique<FocusOutEvent>(widget, reason);
}

std::unique_ptr<FocusEvent> FocusEvent::createFocusChangeEvent(Widget* oldFocus, Widget* newFocus, FocusReason reason) {
    return std::make_unique<FocusChangeEvent>(oldFocus, newFocus, reason);
}

std::unique_ptr<FocusEvent> FocusEvent::createTabFocusEvent(Widget* widget, bool forward) {
    FocusReason reason = forward ? FocusReason::Tab : FocusReason::Backtab;
    return std::make_unique<FocusInEvent>(widget, reason);
}

std::unique_ptr<FocusEvent> FocusEvent::createMouseFocusEvent(Widget* widget, const Point& clickPos) {
    auto event = std::make_unique<FocusInEvent>(widget, FocusReason::Mouse);
    // 可以在这里存储点击位置信息
    event->setAttribute("clickPosition", Variant(clickPos));
    return event;
}

String FocusEvent::focusReasonToString(FocusReason reason) {
    auto it = focusReasonToStringMap.find(reason);
    if (it != focusReasonToStringMap.end()) {
        return it->second;
    }
    return "Unknown";
}

FocusReason FocusEvent::stringToFocusReason(const String& reasonString) {
    initializeStringToFocusReasonMap();
    
    auto it = stringToFocusReasonMap.find(reasonString);
    if (it != stringToFocusReasonMap.end()) {
        return it->second;
    }
    return FocusReason::Other;
}

std::unique_ptr<Event> FocusEvent::clone() const {
    auto cloned = std::make_unique<FocusEvent>(type(), m_oldFocusWidget, m_newFocusWidget, m_reason);
    
    // 复制所有属性
    cloned->setTemporary(m_isTemporary);
    cloned->setFocusPolicy(m_focusPolicy);
    cloned->setNextInFocusChain(m_nextInFocusChain);
    cloned->setPreviousInFocusChain(m_previousInFocusChain);
    cloned->setFocusGroup(m_focusGroup);
    cloned->setFocusOrder(m_focusOrder);
    cloned->setFocusRect(m_focusRect);
    cloned->setPartialFocus(m_hasPartialFocus);
    cloned->setFocusContext(m_focusContext);
    cloned->setFocusHint(m_focusHint);
    cloned->setShowFocusIndicator(m_showFocusIndicator);
    cloned->setAccessibilityText(m_accessibilityText);
    cloned->setAccessibilityRole(m_accessibilityRole);
    
    // 复制基类属性
    cloned->setTimestamp(timestamp());
    cloned->setSource(source());
    cloned->setPriority(priority());
    cloned->setHandled(handled());
    cloned->setPayload(payload());
    cloned->setEventName(eventName());
    
    return std::unique_ptr<Event>(cloned.release());
}

String FocusEvent::toString() const {
    std::ostringstream oss;
    oss << className() << "{"
        << "type=" << static_cast<uint32_t>(type())
        << ", reason=" << focusReasonToString(m_reason);
    
    if (m_oldFocusWidget) {
        oss << ", oldFocus=" << m_oldFocusWidget->getObjectName();
    } else {
        oss << ", oldFocus=null";
    }
    
    if (m_newFocusWidget) {
        oss << ", newFocus=" << m_newFocusWidget->objectName();
    } else {
        oss << ", newFocus=null";
    }
    
    if (m_isTemporary) {
        oss << ", temporary=true";
    }
    
    if (!m_focusGroup.empty()) {
        oss << ", focusGroup=\"" << m_focusGroup << "\"";
    }
    
    if (m_focusOrder != 0) {
        oss << ", focusOrder=" << m_focusOrder;
    }
    
    if (m_hasPartialFocus) {
        oss << ", partialFocus=true"
            << ", focusRect=(" << m_focusRect.x << "," << m_focusRect.y 
            << "," << m_focusRect.width << "," << m_focusRect.height << ")";
    }
    
    if (!m_focusContext.empty()) {
        oss << ", context=\"" << m_focusContext << "\"";
    }
    
    if (!m_focusHint.empty()) {
        oss << ", hint=\"" << m_focusHint << "\"";
    }
    
    if (!m_showFocusIndicator) {
        oss << ", showIndicator=false";
    }
    
    if (!m_accessibilityText.empty()) {
        oss << ", accessibility=\"" << m_accessibilityText << "\"";
    }
    
    oss << ", timestamp=" << timestamp() << "}";
    return oss.str();
}

std::map<String, Variant> FocusEvent::serialize() const {
    auto data = Event::serialize();
    
    // 焦点组件信息（仅存储对象名称，避免指针序列化）
    if (m_oldFocusWidget) {
        data["old_focus_widget"] = Variant(m_oldFocusWidget->objectName());
    }
    if (m_newFocusWidget) {
        data["new_focus_widget"] = Variant(m_newFocusWidget->objectName());
    }
    
    // 焦点原因
    data["focus_reason"] = Variant(static_cast<int>(m_reason));
    data["focus_reason_string"] = Variant(focusReasonToString(m_reason));
    
    // 焦点属性
    data["is_temporary"] = Variant(m_isTemporary);
    data["focus_policy"] = Variant(static_cast<int>(m_focusPolicy));
    
    // 焦点链信息（仅存储对象名称）
    if (m_nextInFocusChain) {
        data["next_in_focus_chain"] = Variant(m_nextInFocusChain->objectName());
    }
    if (m_previousInFocusChain) {
        data["previous_in_focus_chain"] = Variant(m_previousInFocusChain->objectName());
    }
    
    // 焦点组信息
    data["focus_group"] = Variant(m_focusGroup);
    data["focus_order"] = Variant(m_focusOrder);
    
    // 焦点区域
    data["focus_rect_x"] = Variant(m_focusRect.x);
    data["focus_rect_y"] = Variant(m_focusRect.y);
    data["focus_rect_width"] = Variant(m_focusRect.width);
    data["focus_rect_height"] = Variant(m_focusRect.height);
    data["has_partial_focus"] = Variant(m_hasPartialFocus);
    
    // 焦点上下文
    data["focus_context"] = Variant(m_focusContext);
    data["focus_hint"] = Variant(m_focusHint);
    data["show_focus_indicator"] = Variant(m_showFocusIndicator);
    
    // 辅助功能
    data["accessibility_text"] = Variant(m_accessibilityText);
    data["accessibility_role"] = Variant(m_accessibilityRole);
    
    return data;
}

void FocusEvent::deserialize(const std::map<String, Variant>& data) {
    Event::deserialize(data);
    
    // 注意：Widget指针在反序列化时需要特殊处理
    // 这里只能恢复基本的属性，指针需要在运行时重新建立关联
    
    // 焦点原因
    if (data.count("focus_reason")) {
        m_reason = static_cast<FocusReason>(data.at("focus_reason").toInt());
    }
    
    // 焦点属性
    if (data.count("is_temporary")) {
        m_isTemporary = data.at("is_temporary").toBool();
    }
    if (data.count("focus_policy")) {
        m_focusPolicy = static_cast<FocusPolicy>(data.at("focus_policy").toInt());
    }
    
    // 焦点组信息
    if (data.count("focus_group")) {
        m_focusGroup = data.at("focus_group").toString();
    }
    if (data.count("focus_order")) {
        m_focusOrder = data.at("focus_order").toInt();
    }
    
    // 焦点区域
    if (data.count("focus_rect_x") && data.count("focus_rect_y") && 
        data.count("focus_rect_width") && data.count("focus_rect_height")) {
        m_focusRect = Rect(
            data.at("focus_rect_x").toInt(),
            data.at("focus_rect_y").toInt(),
            data.at("focus_rect_width").toInt(),
            data.at("focus_rect_height").toInt()
        );
    }
    if (data.count("has_partial_focus")) {
        m_hasPartialFocus = data.at("has_partial_focus").toBool();
    }
    
    // 焦点上下文
    if (data.count("focus_context")) {
        m_focusContext = data.at("focus_context").toString();
    }
    if (data.count("focus_hint")) {
        m_focusHint = data.at("focus_hint").toString();
    }
    if (data.count("show_focus_indicator")) {
        m_showFocusIndicator = data.at("show_focus_indicator").toBool();
    }
    
    // 辅助功能
    if (data.count("accessibility_text")) {
        m_accessibilityText = data.at("accessibility_text").toString();
    }
    if (data.count("accessibility_role")) {
        m_accessibilityRole = data.at("accessibility_role").toString();
    }
}

} // namespace QGL